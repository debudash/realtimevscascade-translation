{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cascade": {
    "DefaultStrategy": "segment"
  },
  "Providers": {
    "Stt": "deepgram",
    "Translation": "openai",
    "TranslationFallback": "deepl",
    "Tts": "elevenlabs"
  },
  "Languages": {
    "DefaultPair": "en-es",
    "Languages": [
      {
        "Code": "en",
        "Name": "English",
        "NativeName": "English",
        "SpeakerLabel": "English speaker",
        "DeepgramLanguage": "en",
        "DeepLSource": "EN",
        "DeepLTarget": "EN-US"
      },
      {
        "Code": "es",
        "Name": "Spanish",
        "NativeName": "Español",
        "SpeakerLabel": "Hablante de español",
        "DeepgramLanguage": "es",
        "DeepLSource": "ES",
        "DeepLTarget": "ES"
      },
      {
        "Code": "fr",
        "Name": "French",
        "NativeName": "Français",
        "SpeakerLabel": "Locuteur français",
        "DeepgramLanguage": "fr",
        "DeepLSource": "FR",
        "DeepLTarget": "FR"
      }
    ],
    "Pairs": [
      {
        "Id": "en-es",
        "A": "en",
        "B": "es",
        "Label": "English ↔ Spanish"
      },
      {
        "Id": "en-fr",
        "A": "en",
        "B": "fr",
        "Label": "English ↔ French"
      }
    ]
  },
  "TranslationControls": {
    "Enabled": true,
    "Formal": true,
    "Glossary": {
      "en-es": {
        "prescription": "receta",
        "the prescription": "la receta",
        "a prescription": "una receta",
        "appointment": "cita",
        "my appointment": "mi cita",
        "an appointment": "una cita",
        "tablet": "tableta",
        "one tablet": "una tableta",
        "blood pressure": "presión arterial",
        "your blood pressure": "su presión arterial",
        "surgery": "cirugía",
        "procedure": "procedimiento",
        "the procedure": "el procedimiento",
        "test results": "resultados de las pruebas",
        "the test results": "los resultados de las pruebas",
        "medication": "medicamento",
        "any medication": "algún medicamento",
        "health insurance": "seguro médico",
        "emergency room": "sala de emergencias",
        "side effects": "efectos secundarios",
        "dosage": "dosis"
      },
      "es-en": {
        "receta": "prescription",
        "la receta": "the prescription",
        "una receta": "a prescription",
        "recetas": "prescriptions",
        "cita": "appointment",
        "la cita": "the appointment",
        "una cita": "an appointment",
        "pastillas": "pills",
        "las pastillas": "the pills",
        "seguro médico": "health insurance",
        "estómago vacío": "empty stomach",
        "medicamento": "medication",
        "el medicamento": "the medication",
        "este medicamento": "this medication",
        "presión arterial": "blood pressure",
        "sala de emergencias": "emergency room",
        "efectos secundarios": "side effects",
        "dosis": "dosage",
        "farmacia": "pharmacy",
        "análisis de sangre": "blood test"
      }
    }
  }
}
